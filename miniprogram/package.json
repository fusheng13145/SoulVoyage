{
  "name": "miniprogram",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni build -p mp-weixin --watch",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript ../backend/openapi/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "pinia": "^2.2.6",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "sass": "^1.77.8",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "5.2.8",
    "vue-tsc": "^2.1.6"
  }
}
