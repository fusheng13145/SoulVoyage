{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulateReviewResult",
  "type": "object",
  "required": ["turnScores", "keyMoments", "overall", "rewriteSuggestions", "overallAdvice"],
  "properties": {
    "turnScores": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["turn", "dimension", "grade", "comment"],
        "properties": {
          "turn": { "type": "integer", "minimum": 1, "maximum": 20 },
          "dimension": { "enum": ["LISTEN", "BOUNDARY", "EMPATHY", "CONCESSION"] },
          "grade": { "enum": ["A", "B", "C", "D"] },
          "comment": { "type": "string", "maxLength": 200 }
        },
        "additionalProperties": false
      }
    },
    "keyMoments": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["turn", "type", "quote"],
        "properties": {
          "turn": { "type": "integer", "minimum": 1, "maximum": 20 },
          "type": { "type": "string", "maxLength": 32 },
          "quote": { "type": "string", "maxLength": 200 }
        },
        "additionalProperties": false
      }
    },
    "overall": {
      "type": "object",
      "required": ["avgScore", "strengths", "weaknesses"],
      "properties": {
        "avgScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "strengths": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 120 } },
        "weaknesses": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 120 } }
      },
      "additionalProperties": false
    },
    "rewriteSuggestions": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["turn", "original", "optimized"],
        "properties": {
          "turn": { "type": "integer", "minimum": 1, "maximum": 20 },
          "original": { "type": "string", "maxLength": 200 },
          "optimized": { "type": "string", "maxLength": 200 }
        },
        "additionalProperties": false
      }
    },
    "overallAdvice": { "type": "string", "maxLength": 300 },
    "referenceCase": { "type": "string", "pattern": "^cc_[a-z_]+$" },
    "reportId": { "type": "string" }
  },
  "additionalProperties": false
}
