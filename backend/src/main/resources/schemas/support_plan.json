{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupportPlan",
  "type": "object",
  "required": ["planTitle", "matchedExercises", "psyEducation", "disclaimer"],
  "properties": {
    "planTitle": { "type": "string", "maxLength": 64 },
    "matchedExercises": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["exerciseId", "reason", "schedule"],
        "properties": {
          "exerciseId": { "type": "string", "pattern": "^ex_[a-z0-9_]+$" },
          "reason": { "type": "string", "maxLength": 200 },
          "schedule": { "type": "string", "maxLength": 64 }
        },
        "additionalProperties": false
      }
    },
    "psyEducation": {
      "type": "object",
      "required": ["topic", "content", "kgSource"],
      "properties": {
        "topic": { "type": "string", "maxLength": 64 },
        "content": { "type": "string", "maxLength": 600 },
        "kgSource": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "planDays": { "type": "integer", "enum": [3, 5, 7] },
    "planItems": {
      "type": "array", "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["day", "exerciseId", "guidance"],
        "properties": {
          "day": { "type": "integer", "minimum": 1, "maximum": 7 },
          "exerciseId": { "type": "string", "pattern": "^ex_[a-z0-9_]+$" },
          "guidance": { "type": "string", "maxLength": 60 }
        },
        "additionalProperties": false
      }
    },
    "disclaimer": { "type": "boolean", "const": true },
    "reportId": { "type": "string" },
    "planId": { "type": "string" }
  },
  "additionalProperties": false
}
