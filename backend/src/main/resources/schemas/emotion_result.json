{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmotionResult",
  "type": "object",
  "required": ["primaryEmotion", "intensity", "valence", "eventTags"],
  "properties": {
    "primaryEmotion": {
      "enum": ["喜悦","悲伤","愤怒","恐惧","焦虑","羞耻","内疚","厌恶","惊讶","孤独","压力","麻木","平静","困惑","嫉妒","感激"]
    },
    "secondaryEmotions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["emotion", "weight"],
        "properties": {
          "emotion": { "enum": ["喜悦","悲伤","愤怒","恐惧","焦虑","羞耻","内疚","厌恶","惊讶","孤独","压力","麻木","平静","困惑","嫉妒","感激"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "valence": { "type": "number", "minimum": -1, "maximum": 1 },
    "eventTags": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["tag", "evidence"],
        "properties": {
          "tag": { "enum": ["学业压力","人际冲突","宿舍","小组项目","亲子沟通","亲密关系","关系失落","就业焦虑","经济压力","躯体健康","成就事件","日常","其他"] },
          "scene": { "type": "string" },
          "evidence": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "profileDelta": { "type": "object" }
  },
  "additionalProperties": false
}
