# SoulVoyage 环境变量（本机开发直接 export；生产由 deploy/docker-compose.yml 以 --env-file 注入）。
# 真实值放 deploy/local.env（已 gitignore，勿入库）。
SV_MYSQL_HOST=127.0.0.1
SV_MYSQL_PORT=3306
SV_MYSQL_USER=soulvoyage
SV_MYSQL_PASS=CHANGE_ME_local_dev
# 仅 docker-compose mysql 服务初始化 root 用
SV_MYSQL_ROOT_PASS=CHANGE_ME_root
SV_REDIS_HOST=127.0.0.1
SV_REDIS_PORT=6379
# 本机 Redis 留空；docker-compose 的 redis 开了 requirepass，必须填
SV_REDIS_PASS=
SV_MASTER_KEY=<base64-32B>
SV_JWT_SECRET=<48-char-random>
SV_LLM_PROVIDER=mock          # mock | openai；生产 compose 强制显式指定
SV_LLM_BASE_URL=
SV_LLM_API_KEY=
SV_LLM_MODEL=
SV_CORS_ORIGINS=https://example.com   # 逗号分隔白名单；本机开发默认 http://localhost:5173
SV_BUSINESS_ZONE=Asia/Shanghai
