# soul-voyage 环境变量（本机开发直接 export；生产由 deploy/docker-compose.yml 以 --env-file 注入）。
# 真实值放 deploy/local.env（已 gitignore，勿入库）。
SV_MYSQL_HOST=127.0.0.1
SV_MYSQL_PORT=3306
SV_MYSQL_USER=soul_voyage
SV_MYSQL_PASS=CHANGE_ME_local_dev
# 仅 docker-compose mysql 服务初始化 root 用
SV_MYSQL_ROOT_PASS=CHANGE_ME_root
SV_REDIS_HOST=127.0.0.1
SV_REDIS_PORT=6379
# 本机 Redis 留空；docker-compose 的 redis 开了 requirepass，必须填
SV_REDIS_PASS=
SV_MASTER_KEY=<base64-32B>
SV_JWT_SECRET=<48-char-random>
SV_LLM_PROVIDER=mock          # mock | openai；生产 compose 强制显式指定
SV_LLM_BASE_URL=              # Ollama 本机：http://127.0.0.1:11434/v1
SV_LLM_API_KEY=               # Ollama 可填任意非空值（如 ollama）
SV_LLM_MODEL=                 # Ollama 示例：deepseek-r1:8b / qwen2.5:7b-instruct
SV_LLM_TIMEOUT=60s            # 本地 reasoning 模型建议 300s
SV_LLM_MAX_TOKENS_FLOOR=0     # reasoning 模型建议 4096，覆盖思维链后再出 JSON
SV_ASR_PROVIDER=mock          # mock | openai；生产必须显式指定真实 provider
SV_ASR_BASE_URL=
SV_ASR_MODEL=
SV_ASR_API_KEY=
SV_WX_PROVIDER=mock           # mock | http；生产必须为 http
SV_WX_APPID=
SV_WX_SECRET=
SV_CORS_ORIGINS=https://example.com   # 逗号分隔白名单；生产填备案域名（https）
SV_BUSINESS_ZONE=Asia/Shanghai
# 多节点状态面：true=推理闸门/限流窗/任务事件缓冲/导出快照交给 Redis（要求 Redis 可达）；
# false（默认）=全部留在本进程内存，行为与单节点版逐字一致，本机开发与回归无需改动。
# 同一集群内所有节点必须同值。
SV_DISTRIBUTED=false

# Neo4j 知识图谱（本机开发实例：D:/neo4j-community-5.26.12，启动/导种子见 deploy/tools/neo4j.sh）
# enabled=false（默认）时 KG 走 MySQL kg_node 表兜底；true 要求 pom 已引入 neo4j-java-driver 且实例可达
SV_NEO4J_ENABLED=false
SV_NEO4J_URI=bolt://127.0.0.1:7687
SV_NEO4J_USER=neo4j
SV_NEO4J_PASS=CHANGE_ME_neo4j

# H-07 上线收口：域名/证书/预算/慢请求阈值（真实值由运维注入，不入库）
SV_DOMAIN=example.com
SV_TLS_DIR=./certs
SV_LLM_DAILY_TOKENS=2000000
SV_LLM_PRICE_IN=0.001
SV_LLM_PRICE_OUT=0.002
SV_LLM_DAILY_COST=10.0
SV_LLM_BUDGET_CURRENCY=CNY
SV_LLM_BUDGET_ALERT_PERCENT=80
SV_SLOW_REQUEST_MS=500
